# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
FLASK_DEBUG=0

# --- Database (PostgreSQL / Supabase) ------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Keep a small in-process connection pool. Set to 0 to open one connection per request.
USE_LOCAL_POOL=1

# --- GapGPT API -----------------------------------------------------------
GAPGPT_API_KEY=[Write your own API key]
GAPGPT_API_URL=https://api.gapgpt.app/v1/chat/completions
IMAGE_GENERATION_API_URL=https://api.gapgpt.app/v1/images/generations

# --- Sessions -------------------------------------------------------------
# Signs the session cookie. Defaults to GAPGPT_API_KEY when left empty.
SESSION_SECRET=[Generate a long random string]
